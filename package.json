{
  "name": "stack",
  "productName": "Stack",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal session manager for running many Claude Code sessions at once",
  "main": "out/server/index.js",
  "scripts": {
    "start": "npm run build --silent && node out/server/index.js",
    "start:standalone": "npm run build --silent && node out/server/index.js --standalone",
    "build": "node scripts/build.mjs && vite build --logLevel warn",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "node scripts/fix-spawn-helper.mjs"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "electron": "^45.3.2",
    "node-pty": "^1.1.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "node-pty": false,
    "electron-winstaller": false
  }
}
